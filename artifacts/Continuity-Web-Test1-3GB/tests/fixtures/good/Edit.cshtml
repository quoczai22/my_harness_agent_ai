@model TraiCay
@{
    ViewData["Title"] = "Sửa trái cây";
}
<form method="post" asp-action="Edit">
    <input type="hidden" asp-for="MaTC" />
    <input asp-for="TenTC" />
    <input asp-for="Gia" />
    <input asp-for="NgayNhap" type="date" />
    <select asp-for="MaNCC" asp-items="ViewBag.MaNCC"></select>
    <button type="submit">Lưu</button>
</form>
