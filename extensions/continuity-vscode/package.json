{
  "name": "continuity-vscode",
  "displayName": "Continuity Workflow",
  "description": "Offline, read-only Continuity workflow views with an explicit local Ollama helper and Offline Code Assistant.",
  "version": "0.3.1",
  "private": true,
  "publisher": "quoczai22",
  "license": "MIT",
  "icon": "media/continuity.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "continuity",
          "title": "Continuity",
          "icon": "media/continuity.svg"
        }
      ]
    },
    "views": {
      "continuity": [
        {
          "id": "continuity.workflow",
          "name": "Workflow",
          "icon": "media/continuity.svg"
        },
        {
          "type": "webview",
          "id": "continuity.assistant.sessions",
          "name": "Assistant: Sessions",
          "icon": "media/continuity.svg"
        },
        {
          "type": "webview",
          "id": "continuity.assistant.chat",
          "name": "Assistant: Chat",
          "icon": "media/continuity.svg"
        },
        {
          "type": "webview",
          "id": "continuity.assistant.composer",
          "name": "Assistant: Composer",
          "icon": "media/continuity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "continuity.refresh",
        "title": "Continuity: Refresh Workflow"
      },
      {
        "command": "continuity.assistant.rebuildStyleProfile",
        "title": "Assistant: Rebuild Style Profile"
      },
      {
        "command": "continuity.assistant.openCodeStyle",
        "title": "Assistant: Open Project Coding Style"
      },
      {
        "command": "continuity.assistant.clearSessions",
        "title": "Assistant: Clear All Sessions"
      },
      {
        "command": "continuity.assistant.exportSessions",
        "title": "Assistant: Export Sessions"
      },
      {
        "command": "continuity.assistant.importSessions",
        "title": "Assistant: Import Sessions"
      },
      {
        "command": "continuity.openTimeline",
        "title": "Continuity: Open Timeline"
      },
      {
        "command": "continuity.summarizeWithOllama",
        "title": "Continuity: Summarize with Local Ollama"
      },
      {
        "command": "continuity.setOpenAIKey",
        "title": "Continuity: Set OpenAI API Key"
      },
      {
        "command": "continuity.clearOpenAIKey",
        "title": "Continuity: Clear OpenAI API Key"
      },
      {
        "command": "continuity.toggleTrustedAutoWrite",
        "title": "Continuity: Toggle Trusted Workspace Auto-Write"
      },
      {
        "command": "continuity.buildWorkspaceIndex",
        "title": "Continuity: Build Workspace Index"
      },
      {
        "command": "continuity.clearWorkspaceIndex",
        "title": "Continuity: Clear Workspace Index"
      },
      {
        "command": "continuity.viewAutoWriteAudit",
        "title": "Continuity: View Auto-Write Audit Log"
      },
      {
        "command": "continuity.applyTrustedProposal",
        "title": "Continuity: Apply Trusted Agent Proposal"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "continuity.refresh",
          "when": "view == continuity.workflow",
          "group": "navigation"
        },
        {
          "command": "continuity.openTimeline",
          "when": "view == continuity.workflow",
          "group": "navigation@1"
        },
        {
          "command": "continuity.applyTrustedProposal",
          "when": "view == continuity.assistant.composer",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Continuity",
      "properties": {
        "continuity.ollamaModel": {
          "type": "string",
          "default": "",
          "description": "Optional local Ollama model. The helper only calls http://127.0.0.1:11434 after you run its command."
        },
        "continuity.summaryProvider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai"
          ],
          "default": "ollama",
          "description": "Summary provider. OpenAI is opt-in."
        },
        "continuity.openaiModel": {
          "type": "string",
          "default": "gpt-6-astra",
          "description": "OpenAI model used when OpenAI provider is selected."
        },
        "continuity.offlineAssistantModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Local model for Offline Assistant. Requests are restricted to Ollama at 127.0.0.1:11434."
        },
        "continuity.offlineAssistantProvider": {
          "type": "string",
          "enum": [
            "ollama",
            "lmstudio"
          ],
          "default": "ollama",
          "description": "Local inference provider for Offline Assistant and trusted proposal planning."
        },
        "continuity.lmStudioEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:1234",
          "description": "Local LM Studio server URL. Only HTTP loopback is accepted."
        },
        "continuity.lmStudioModel": {
          "type": "string",
          "default": "",
          "description": "Identifier of a model loaded in the local LM Studio server."
        },
        "continuity.pdfTextExecutable": {
          "type": "string",
          "default": "",
          "description": "Path to a locally installed pdftotext executable for offline PDF text extraction."
        },
        "continuity.ollamaAutoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the installed local Ollama service automatically when Continuity activates. Uses only 127.0.0.1 and never downloads models."
        },
        "continuity.inlineCompletions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local inline completions powered by Ollama."
        },
        "continuity.trustedAutoWrite.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable opt-in Trusted Workspace Auto-Write for safe create/replace edits."
        },
        "continuity.workspaceIndex.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable opt-in bounded workspace indexing."
        }
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/vendor-pdfjs.cjs",
    "test": "npm run build && node --test dist/**/*.test.js",
    "package": "npm run build && vsce package --out continuity-workflow.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "url": "https://github.com/quoczai22/my_harness_agent_ai.git",
    "type": "git"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  }
}
