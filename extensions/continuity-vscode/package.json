{
  "name": "continuity-vscode",
  "displayName": "Continuity Workflow",
  "description": "Offline, read-only Continuity workflow views with an explicit local Ollama helper and Offline Code Assistant.",
  "version": "0.2.0",
  "private": true,
  "publisher": "quoczai22",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:continuity.workflow",
    "onView:continuity.assistant.sessions",
    "onView:continuity.assistant.chat",
    "onView:continuity.assistant.composer",
    "onCommand:continuity.refresh",
    "onCommand:continuity.openTimeline",
    "onCommand:continuity.summarizeWithOllama",
    "onCommand:continuity.assistant.rebuildStyleProfile",
    "onCommand:continuity.assistant.clearSessions"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "continuity",
          "title": "Continuity",
          "icon": "media/continuity.svg"
        }
      ]
    },
    "views": {
      "continuity": [
        {
          "id": "continuity.workflow",
          "name": "Workflow"
        },
        {
          "type": "webview",
          "id": "continuity.assistant.sessions",
          "name": "Assistant: Sessions"
        },
        {
          "type": "webview",
          "id": "continuity.assistant.chat",
          "name": "Assistant: Chat"
        },
        {
          "type": "webview",
          "id": "continuity.assistant.composer",
          "name": "Assistant: Composer"
        }
      ]
    },
    "commands": [
      {
        "command": "continuity.refresh",
        "title": "Continuity: Refresh Workflow"
      },
      {
        "command": "continuity.assistant.rebuildStyleProfile",
        "title": "Assistant: Rebuild Style Profile"
      },
      {
        "command": "continuity.assistant.clearSessions",
        "title": "Assistant: Clear All Sessions"
      },
      {
        "command": "continuity.openTimeline",
        "title": "Continuity: Open Timeline"
      },
      {
        "command": "continuity.summarizeWithOllama",
        "title": "Continuity: Summarize with Local Ollama"
      },
      {
        "command": "continuity.setOpenAIKey",
        "title": "Continuity: Set OpenAI API Key"
      },
      {
        "command": "continuity.clearOpenAIKey",
        "title": "Continuity: Clear OpenAI API Key"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "continuity.refresh",
          "when": "view == continuity.workflow",
          "group": "navigation"
        },
        {
          "command": "continuity.openTimeline",
          "when": "view == continuity.workflow",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Continuity",
      "properties": {
        "continuity.ollamaModel": {
          "type": "string",
          "default": "",
          "description": "Optional local Ollama model. The helper only calls http://127.0.0.1:11434 after you run its command."
        },
        "continuity.summaryProvider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai"
          ],
          "default": "ollama",
          "description": "Summary provider. OpenAI is opt-in."
        },
        "continuity.openaiModel": {
          "type": "string",
          "default": "gpt-6-astra",
          "description": "OpenAI model used when OpenAI provider is selected."
        },
        "continuity.offlineAssistantModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Local model for Offline Assistant. Requests are restricted to Ollama at 127.0.0.1:11434."
        }
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/**/*.test.js",
    "package": "npm run build && vsce package --out continuity-workflow.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "url": "https://github.com/quoczai22/my_harness_agent_ai.git",
    "type": "git"
  }
}